DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
AUTH_SECRET=generate-a-long-random-string
# Required for resume reviews. OpenRouter is the default gateway.
OPENROUTER_API_KEY=
# Optional alias when the gateway is not OpenRouter.
LLM_API_KEY=
# OpenAI-compatible chat completions base URL.
# Point this at LiteLLM, MiniLLM, Bedrock Mantle, or another gateway if you are not using OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Bedrock Mantle (OpenAI-compatible) example:
# LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# OPENAI_API_KEY=your-bedrock-api-key
# OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# OPENAI_PROJECT_ID=default
# Optional model override (defaults to openai.gpt-oss-120b for Mantle).
# LLM_REVIEW_MODEL=openai.gpt-oss-120b
# Shown when a user hits the daily review limit. Set to Suraj's profile URL.
# CONTACT_LINKEDIN_URL=https://www.linkedin.com/in/your-name
